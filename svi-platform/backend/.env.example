# Copy this file to .env (or just export these) before running in anything
# other than local dev. Django works fine without it — these all have
# sane local-dev defaults baked into settings.py.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
